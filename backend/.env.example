# Application Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
PUBLIC_API_URL=http://localhost:4000/api/v1

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d

# Mail Server Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email
MAIL_PASS=your_password
MAIL_FROM="Vehicle Identity System <noreply@example.com>"

# SMS Configuration
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=VEHICLE_ID

# Storage / Upload Configuration
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Payment Gateways (Nepal)
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret
KHAKTI_SECRET_KEY=your_khalti_secret
FONEPAY_MERCHANT_CODE=your_fonepay_code

# Firebase Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"
